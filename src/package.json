{
	"private": true,
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "bun --bun next dev",
		"build": "bun --bun next build",
		"start": "bun --bun next start",
		"dev:mock": "cross-env NEXT_PUBLIC_USE_SAMPLE_DATA=true bun --bun next dev",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:db": "supabase test db --workdir ..",
		"e2e": "playwright test",
		"e2e:smoke": "playwright test --grep @smoke",
		"e2e:ui": "playwright test --ui",
		"e2e:report": "playwright show-report",
		"e2e:db": "supabase start --workdir ..",
		"cron": "bun scripts/run-cron.ts",
		"hooks:install": "git config core.hooksPath .githooks",
		"logo:icon": "bun scripts/generate-logo-icon.ts"
	},
